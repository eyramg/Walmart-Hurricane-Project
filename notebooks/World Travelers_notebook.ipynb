        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "from pathlib import Path\n",
        "\n",
        "\n",
        "candidates = [\n",
        "    Path(\"sample_data/walmart_transactions.csv\"),\n",
        "    Path(\"data/walmart_transactions (1).csv\"),\n",
        "    Path(\"data/walmart_transactions(1).csv\"),\n",
        "    Path(\"walmart_transactions.csv\"),\n",
        "    Path(\"walmart_transactions (1).csv\"),\n",
        "    Path(\"walmart_transactions(1).csv\"),\n",
        "    Path(\"/content/walmart_transactions.csv\"),\n",
        "    Path(\"/content/walmart_transactions (1).csv\"),\n",
        "    Path(\"/content/walmart_transactions(1).csv\"),\n",
        "    Path(\"/mnt/data/walmart_transactions(1).csv\")\n",
        "]\n",
        "\n",
        "data_path = next(\n",
        "    (p for p in candidates if p.exists()), None\n",
        ")\n",
        "\n",
        "if data_path is None:\n",
        "    raise FileNotFoundError(\n",
        "        \"Upload your Walmart transactions CSV first.\"\n",
        "    )\n",
        "\n",
        "raw_df = pd.read_csv(data_path)\n",
        "print(\"Original rows:\", len(raw_df))\n",
        "\n",
        "\n",
        "df = raw_df.drop_duplicates().copy()\n",
        "\n",
        "\n",
        "df[\"quantity\"] = pd.to_numeric(\n",
        "    df[\"quantity\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "\n",
        "df = df[df[\"quantity\"] > 0].copy()\n",
        "\n",
        "\n",
        "df[\"timestamp\"] = pd.to_datetime(\n",
        "    df[\"timestamp\"],\n",
        "    format=\"mixed\",\n",
        "    errors=\"coerce\"\n",
        ")\n",
        "\n",
        "missing_dates = df[\"timestamp\"].isna().sum()\n",
        "print(\"Rows with missing/invalid dates:\", missing_dates)\n",
        "\n",
        "df = df.dropna(subset=[\"timestamp\"]).copy()\n",
        "df[\"date\"] = df[\"timestamp\"].dt.normalize()\n",
        "\n",
        "\n",
        "\n",
        "# Standardize product category names\n",
        "\n",
        "def clean_category(value):\n",
        "    if pd.isna(value):\n",
        "        return \"Unknown\"\n",
        "\n",
        "    name = str(value).strip().lower()\n",
        "    name = \" \".join(name.replace(\"&\", \" and \").split())\n",
        "\n",
        "    category_mapping = {\n",
        "        \"breakfast\": \"Breakfast Foods\",\n",
        "        \"breakfast foods\": \"Breakfast Foods\",\n",
        "\n",
        "        \"alcohol\": \"Alcoholic Beverages\",\n",
        "        \"alcoholic beverages\": \"Alcoholic Beverages\",\n",
        "\n",
        "        \"health\": \"Health and Wellness\",\n",
        "        \"health and wellness\": \"Health and Wellness\",\n",
        "\n",
        "        \"baby\": \"Baby Products\",\n",
        "        \"baby products\": \"Baby Products\",\n",
        "\n",
        "        \"grocery\": \"Grocery\",\n",
        "        \"groceries\": \"Grocery\",\n",
        "\n",
        "        \"emergency\": \"Emergency Supplies\",\n",
        "        \"emergency supplies\": \"Emergency Supplies\",\n",
        "\n",
        "        \"household\": \"Household\",\n",
        "        \"household essentials\": \"Household\",\n",
        "\n",
        "        \"entertainment\": \"Entertainment\",\n",
        "        \"games and entertainment\": \"Entertainment\"\n",
        "    }\n",
        "\n",
        "    return category_mapping.get(name, name.title())\n",
        "\n",
        "\n",
        "# Apply the updated category cleaning\n",
        "df[\"category_clean\"] = df[\"category\"].apply(clean_category)\n",
        "\n",
        "print(\"Categories after cleaning:\")\n",
        "print(sorted(df[\"category_clean\"].unique()))\n",
        "\n",
        "\n",
        "\n",
        "baseline_start = \"2024-09-01\"\n",
        "baseline_end = \"2024-09-10\"\n",
        "\n",
        "surge_start = \"2024-09-19\"\n",
        "surge_end = \"2024-09-25\"\n",
        "\n",
        "baseline_days = (\n",
        "    pd.Timestamp(baseline_end)\n",
        "    - pd.Timestamp(baseline_start)\n",
        ").days + 1\n",
        "\n",
        "surge_days = (\n",
        "    pd.Timestamp(surge_end)\n",
        "    - pd.Timestamp(surge_start)\n",
        ").days + 1\n",
        "\n",
        "\n",
        "daily_orders = (\n",
        "    df.groupby(\"date\")[\"transaction_id\"]\n",
        "    .nunique()\n",
        "    .sort_index()\n",
        ")\n",
        "\n",
        "all_dates = pd.date_range(\n",
        "    df[\"date\"].min(),\n",
        "    df[\"date\"].max(),\n",
        "    freq=\"D\"\n",
        ")\n",
        "\n",
        "daily_orders = daily_orders.reindex(\n",
        "    all_dates, fill_value=0\n",
        ")\n",
        "\n",
        "baseline_avg = daily_orders.loc[\n",
        "    baseline_start:baseline_end\n",
        "].mean()\n",
        "\n",
        "surge_avg = daily_orders.loc[\n",
        "    surge_start:surge_end\n",
        "].mean()\n",
        "\n",
        "overall_change = (\n",
        "    (surge_avg / baseline_avg) - 1\n",
        ") * 100 if baseline_avg > 0 else np.nan\n",
        "\n",
        "print(\"\\nQ1 — Overall Demand\")\n",
        "print(\"Baseline:\", baseline_start, \"to\", baseline_end)\n",
        "print(\"Surge:\", surge_start, \"to\", surge_end)\n",
        "print(\"Baseline average orders/day:\", round(baseline_avg, 2))\n",
        "print(\"Surge average orders/day:\", round(surge_avg, 2))\n",
        "print(\"Overall percentage change:\", round(overall_change, 2))\n",
        "\n",
        "\n",
        "baseline = df[\n",
        "    df[\"date\"].between(baseline_start, baseline_end)\n",
        "].copy()\n",
        "\n",
        "surge = df[\n",
        "    df[\"date\"].between(surge_start, surge_end)\n",
        "].copy()\n",
        "\n",
        "baseline_units = (\n",
        "    baseline.groupby(\"category_clean\")[\"quantity\"]\n",
        "    .sum()\n",
        "    .div(baseline_days)\n",
        "    .rename(\"baseline_daily_units\")\n",
        ")\n",
        "\n",
        "surge_units = (\n",
        "    surge.groupby(\"category_clean\")[\"quantity\"]\n",
        "    .sum()\n",
        "    .div(surge_days)\n",
        "    .rename(\"surge_daily_units\")\n",
        ")\n",
        "\n",
        "category_results = pd.concat(\n",
        "    [baseline_units, surge_units],\n",
        "    axis=1\n",
        ").fillna(0)\n",
        "\n",
        "category_results[\"percent_change\"] = (\n",
        "    (\n",
        "        category_results[\"surge_daily_units\"]\n",
        "        / category_results[\"baseline_daily_units\"].replace(\n",
        "            0, np.nan\n",
        "        )\n",
        "    ) - 1\n",
        ") * 100\n",
        "\n",
        "category_results = category_results.sort_values(\n",
        "    \"percent_change\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"\\nQ1 — Category Demand Changes\")\n",
        "display(category_results.round(2))\n"
      ]
    },
