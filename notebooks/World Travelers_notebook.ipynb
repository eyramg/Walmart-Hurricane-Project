      "source": [
        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import requests\n",
        "import matplotlib.pyplot as plt\n",
        "import time\n",
        "\n",
        "stores = pd.read_csv(\"store_locations.csv\")\n",
        "\n",
        "stores.columns = (\n",
        "    stores.columns.astype(str)\n",
        "    .str.strip()\n",
        "    .str.lower()\n",
        "    .str.replace(\" \", \"_\")\n",
        ")\n",
        "\n",
        "stores = stores.loc[\n",
        "    :, ~stores.columns.str.startswith(\"unnamed\")\n",
        "].copy()\n",
        "\n",
        "stores = stores.rename(columns={\n",
        "    \"lat\": \"latitude\",\n",
        "    \"lon\": \"longitude\",\n",
        "    \"lng\": \"longitude\",\n",
        "    \"store_number\": \"store_id\"\n",
        "})\n",
        "\n",
        "required = [\"store_id\", \"latitude\", \"longitude\"]\n",
        "missing = [c for c in required if c not in stores.columns]\n",
        "\n",
        "if missing:\n",
        "    raise ValueError(f\"Missing columns: {missing}\")\n",
        "\n",
        "def clean_store_id(series):\n",
        "    return (\n",
        "        series.astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "        .str.replace(r\"[\\s_-]+\", \"\", regex=True)\n",
        "        .str.replace(r\"^FL(\\d+)$\", r\"FL-\\1\", regex=True)\n",
        "    )\n",
        "\n",
        "stores[\"store_id\"] = clean_store_id(stores[\"store_id\"])\n",
        "\n",
        "stores[\"latitude\"] = pd.to_numeric(\n",
        "    stores[\"latitude\"], errors=\"coerce\"\n",
        ")\n",
        "stores[\"longitude\"] = pd.to_numeric(\n",
        "    stores[\"longitude\"], errors=\"coerce\"\n",
        ")\n",
        "\n",
        "stores = stores.drop_duplicates(\n",
        "    subset=[\"store_id\", \"latitude\", \"longitude\"]\n",
        ").copy()\n",
        "\n",
        "conflicts = stores[\n",
        "    stores.duplicated(\"store_id\", keep=False)\n",
        "]\n",
        "\n",
        "if not conflicts.empty:\n",
        "    display(conflicts)\n",
        "    raise ValueError(\n",
        "        \"Some stores have conflicting coordinates.\"\n",
        "    )\n",
        "\n",
        "missing_locations = stores[\n",
        "    stores[[\"latitude\", \"longitude\"]].isna().any(axis=1)\n",
        "].copy()\n",
        "\n",
        "print(\"Stores missing coordinates:\")\n",
        "display(missing_locations)\n",
        "\n",
        "stores = stores.dropna(\n",
        "    subset=[\"store_id\", \"latitude\", \"longitude\"]\n",
        ").copy()\n",
        "\n",
        "assert stores[\"store_id\"].is_unique\n",
        "\n",
        "print(\"Stores with valid locations:\", len(stores))\n",
        "\n",
        "orders = df.copy()\n",
        "\n",
        "orders[\"store_id\"] = clean_store_id(\n",
        "    orders[\"store_id\"]\n",
        ")\n",
        "\n",
        "orders[\"date\"] = pd.to_datetime(\n",
        "    orders[\"timestamp\"],\n",
        "    format=\"mixed\",\n",
        "    errors=\"coerce\"\n",
        ").dt.normalize()\n",
        "\n",
        "orders = orders.dropna(\n",
        "    subset=[\"date\", \"store_id\", \"transaction_id\"]\n",
        ")\n",
        "\n",
        "orders = orders[\n",
        "    orders[\"date\"].between(\n",
        "        \"2024-09-01\", \"2024-09-30\"\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "daily = (\n",
        "    orders.groupby([\"store_id\", \"date\"])[\"transaction_id\"]\n",
        "    .nunique()\n",
        "    .reset_index(name=\"daily_orders\")\n",
        ")\n",
        "\n",
        "unmatched = sorted(\n",
        "    set(daily[\"store_id\"]) - set(stores[\"store_id\"])\n",
        ")\n",
        "\n",
        "print(\"Stores excluded from weather analysis:\", unmatched)\n",
        "\n",
        "daily = daily[\n",
        "    daily[\"store_id\"].isin(stores[\"store_id\"])\n",
        "].copy()\n",
        "\n",
        "if daily.empty:\n",
        "    raise ValueError(\"No stores matched.\")\n",
        "\n",
        "all_dates = pd.date_range(\n",
        "    \"2024-09-01\", \"2024-09-30\"\n",
        ")\n",
        "\n",
        "all_store_dates = pd.MultiIndex.from_product(\n",
        "    [sorted(daily[\"store_id\"].unique()), all_dates],\n",
        "    names=[\"store_id\", \"date\"]\n",
        ").to_frame(index=False)\n",
        "\n",
        "daily = all_store_dates.merge(\n",
        "    daily,\n",
        "    on=[\"store_id\", \"date\"],\n",
        "    how=\"left\",\n",
        "    validate=\"one_to_one\"\n",
        ")\n",
        "\n",
        "daily[\"daily_orders\"] = (\n",
        "    daily[\"daily_orders\"].fillna(0).astype(int)\n",
        ")\n",
        "\n",
        "url = \"https://archive-api.open-meteo.com/v1/archive\"\n",
        "\n",
        "weather_frames = []\n",
        "\n",
        "for _, store in stores.iterrows():\n",
        "\n",
        "    store_id = store[\"store_id\"]\n",
        "\n",
        "    if store_id not in set(daily[\"store_id\"]):\n",
        "        continue\n",
        "\n",
        "    params = {\n",
        "        \"latitude\": float(store[\"latitude\"]),\n",
        "        \"longitude\": float(store[\"longitude\"]),\n",
        "        \"start_date\": \"2024-09-01\",\n",
        "        \"end_date\": \"2024-09-30\",\n",
        "        \"daily\": (\n",
        "            \"precipitation_sum,\"\n",
        "            \"temperature_2m_max,\"\n",
        "            \"wind_speed_10m_max,\"\n",
        "            \"pressure_msl_mean\"\n",
        "        ),\n",
        "        \"wind_speed_unit\": \"kmh\",\n",
        "        \"timezone\": \"America/New_York\"\n",
        "    }\n",
        "\n",
        "    response = requests.get(\n",
        "        url, params=params, timeout=30\n",
        "    )\n",
        "    response.raise_for_status()\n",
        "\n",
        "    data = response.json()[\"daily\"]\n",
        "\n",
        "    store_weather = pd.DataFrame({\n",
        "        \"store_id\": store_id,\n",
        "        \"date\": pd.to_datetime(data[\"time\"]),\n",
        "        \"precipitation_mm\": data[\"precipitation_sum\"],\n",
        "        \"max_temp_c\": data[\"temperature_2m_max\"],\n",
        "        \"wind_speed_kmh\": data[\"wind_speed_10m_max\"],\n",
        "        \"pressure_hpa\": data[\"pressure_msl_mean\"]\n",
        "    })\n",
        "\n",
        "    weather_frames.append(store_weather)\n",
        "\n",
        "    print(\"Retrieved weather for:\", store_id)\n",
        "    time.sleep(0.3)\n",
        "\n",
        "weather = pd.concat(weather_frames, ignore_index=True)\n",
        "\n",
        "assert not weather.duplicated(\n",
        "    [\"store_id\", \"date\"]\n",
        ").any()\n",
        "\n",
        "merged = daily.merge(\n",
        "    weather,\n",
        "    on=[\"store_id\", \"date\"],\n",
        "    how=\"left\",\n",
        "    validate=\"one_to_one\",\n",
        "    indicator=True\n",
        ")\n",
        "\n",
        "assert len(merged) == len(daily)\n",
        "assert (merged[\"_merge\"] == \"both\").all()\n",
        "\n",
        "merged = merged.drop(columns=\"_merge\")\n",
        "\n",
        "print(\"\\nMissing weather values:\")\n",
        "print(\n",
        "    merged[\n",
        "        [\n",
        "            \"precipitation_mm\",\n",
        "            \"max_temp_c\",\n",
        "            \"wind_speed_kmh\",\n",
        "            \"pressure_hpa\"\n",
        "        ]\n",
        "    ].isna().sum()\n",
        ")\n",
        "\n",
        "baseline = merged[\n",
        "    merged[\"date\"].between(\n",
        "        \"2024-09-01\", \"2024-09-10\"\n",
        "    )\n",
        "]\n",
        "\n",
        "surge = merged[\n",
        "    merged[\"date\"].between(\n",
        "        \"2024-09-19\", \"2024-09-25\"\n",
        "    )\n",
        "]\n",
        "\n",
        "comparison = pd.concat(\n",
        "    [\n",
        "        baseline.groupby(\"store_id\")[\"daily_orders\"]\n",
        "        .mean()\n",
        "        .rename(\"baseline_avg_orders\"),\n",
        "\n",
        "        surge.groupby(\"store_id\")[\"daily_orders\"]\n",
        "        .mean()\n",
        "        .rename(\"surge_avg_orders\")\n",
        "    ],\n",
        "    axis=1\n",
        ")\n",
        "\n",
        "comparison[\"percent_change\"] = (\n",
        "    (\n",
        "        comparison[\"surge_avg_orders\"] /\n",
        "        comparison[\"baseline_avg_orders\"].replace(0, np.nan)\n",
        "    ) - 1\n",
        ") * 100\n",
        "\n",
        "print(\"\\nAverage Daily Orders by Store:\")\n",
        "display(comparison.round(2))\n",
        "\n",
        "heatmap_data = merged.pivot(\n",
        "    index=\"store_id\",\n",
        "    columns=\"date\",\n",
        "    values=\"daily_orders\"\n",
        ")\n",
        "\n",
        "heatmap_data = heatmap_data.sort_index()\n",
        "\n",
        "fig, ax = plt.subplots(figsize=(16, 6))\n",
        "\n",
        "image = ax.imshow(\n",
        "    heatmap_data.values,\n",
        "    aspect=\"auto\",\n",
        "    cmap=\"YlOrRd\",\n",
        "    interpolation=\"nearest\"\n",
        ")\n",
        "\n",
        "ax.set_yticks(\n",
        "    np.arange(len(heatmap_data.index))\n",
        ")\n",
        "ax.set_yticklabels(heatmap_data.index)\n",
        "\n",
        "ax.set_xticks(\n",
        "    np.arange(len(heatmap_data.columns))\n",
        ")\n",
        "ax.set_xticklabels(\n",
        "    [\n",
        "        date.strftime(\"%b %d\")\n",
        "        for date in heatmap_data.columns\n",
        "    ],\n",
        "    rotation=60,\n",
        "    ha=\"right\",\n",
        "    fontsize=8\n",
        ")\n",
        "\n",
        "ax.set_title(\n",
        "    \"Walmart Daily Orders Increased Before the Storm — September 2024\",\n",
        "    fontsize=14,\n",
        "    weight=\"bold\",\n",
        "    pad=15\n",
        ")\n",
        "\n",
        "ax.set_xlabel(\"Date\")\n",
        "ax.set_ylabel(\"Walmart Store\")\n",
        "\n",
        "start_col = list(heatmap_data.columns).index(\n",
        "    pd.Timestamp(\"2024-09-19\")\n",
        ")\n",
        "\n",
        "end_col = list(heatmap_data.columns).index(\n",
        "    pd.Timestamp(\"2024-09-25\")\n",
        ")\n",
        "\n",
        "from matplotlib.patches import Rectangle\n",
        "\n",
        "surge_outline = Rectangle(\n",
        "    (start_col - 0.5, -0.5),\n",
        "    end_col - start_col + 1,\n",
        "    len(heatmap_data.index),\n",
        "    fill=False,\n",
        "    edgecolor=\"blue\",\n",
        "    linewidth=2,\n",
        "    label=\"Sept 19–25 surge period\"\n",
        ")\n",
        "\n",
        "ax.add_patch(surge_outline)\n",
        "ax.legend(loc=\"upper left\", bbox_to_anchor=(1.02, 0.15))\n",
        "\n",
        "colorbar = fig.colorbar(\n",
        "    image, ax=ax, pad=0.02\n",
        ")\n",
        "colorbar.set_label(\"Daily Orders\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "correlations = merged[\n",
        "    [\n",
        "        \"daily_orders\",\n",
        "        \"precipitation_mm\",\n",
        "        \"max_temp_c\",\n",
        "        \"wind_speed_kmh\",\n",
        "        \"pressure_hpa\"\n",
        "    ]\n",
        "].corr()[\"daily_orders\"]\n",
        "\n",
        "print(\"\\nCorrelations with Daily Orders:\")\n",
        "print(correlations.round(3))\n",
        "\n",
        "\n",
        "daily_summary = (\n",
        "    merged.groupby(\"date\", as_index=False)\n",
        "    .agg(\n",
        "        total_orders=(\"daily_orders\", \"sum\"),\n",
        "        avg_wind_kmh=(\"wind_speed_kmh\", \"mean\"),\n",
        "        avg_pressure_hpa=(\"pressure_hpa\", \"mean\"),\n",
        "        avg_rainfall_mm=(\"precipitation_mm\", \"mean\")\n",
        "    )\n",
        ")\n",
        "\n",
        "print(\"\\nDaily Orders and Weather Summary:\")\n",
        "display(daily_summary.round(2))\n",
        "\n",
        "merged.to_csv(\n",
        "    \"q3_store_weather_orders.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "comparison.to_csv(\n",
        "    \"q3_store_demand_comparison.csv\"\n",
        ")\n",
        "\n",
        "daily_summary.to_csv(\n",
        "    \"q3_daily_weather_summary.csv\",\n",
        "    index=False\n",
        ")\n",
        "\n",
        "fig.savefig(\n",
        "    \"q3_orders_heatmap.png\",\n",
        "    dpi=200,\n",
        "    bbox_inches=\"tight\"\n",
        ")\n",
        "\n",
        "print(\"\\nQ3 analysis completed successfully.\")\n",
        "print(\"Saved three CSV files and one heatmap.\")\n",
        "print(\"Excluded stores:\", unmatched)\n"
      ]
    },
