        "\n",
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "\n",
        "store_df = df.copy()\n",
        "\n",
        "\n",
        "def clean_store_id(series):\n",
        "    cleaned = (\n",
        "        series.astype(\"string\")\n",
        "        .str.strip()\n",
        "        .str.upper()\n",
        "        .str.replace(r\"[\\s_-]+\", \"\", regex=True)\n",
        "        .str.replace(r\"^FL(\\d+)$\", r\"FL-\\1\", regex=True)\n",
        "    )\n",
        "\n",
        "    return cleaned\n",
        "\n",
        "store_df[\"store_id_clean\"] = clean_store_id(\n",
        "    store_df[\"store_id\"]\n",
        ")\n",
        "\n",
        "\n",
        "print(\n",
        "    \"Original unique store IDs:\",\n",
        "    store_df[\"store_id\"].nunique()\n",
        ")\n",
        "\n",
        "print(\n",
        "    \"Cleaned unique store IDs:\",\n",
        "    store_df[\"store_id_clean\"].nunique()\n",
        ")\n",
        "\n",
        "store_mapping = (\n",
        "    store_df[[\"store_id\", \"store_id_clean\"]]\n",
        "    .drop_duplicates()\n",
        "    .sort_values([\"store_id_clean\", \"store_id\"])\n",
        ")\n",
        "\n",
        "print(\"\\nStore ID mapping:\")\n",
        "display(store_mapping)\n",
        "\n",
        "\n",
        "assert store_df[\"store_id_clean\"].notna().all()\n",
        "\n",
        "unexpected_ids = store_df[\n",
        "    ~store_df[\"store_id_clean\"].str.fullmatch(\n",
        "        r\"FL-\\d+\", na=False\n",
        "    )\n",
        "]\n",
        "\n",
        "print(\"Rows with unexpected store IDs:\", len(unexpected_ids))\n",
        "\n",
        "if len(unexpected_ids) > 0:\n",
        "    display(\n",
        "        unexpected_ids[\n",
        "            [\"store_id\", \"store_id_clean\"]\n",
        "        ].drop_duplicates()\n",
        "    )\n",
        "\n",
        "\n",
        "baseline_store = store_df[\n",
        "    store_df[\"date\"].between(\n",
        "        baseline_start, baseline_end\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "surge_store = store_df[\n",
        "    store_df[\"date\"].between(\n",
        "        surge_start, surge_end\n",
        "    )\n",
        "].copy()\n",
        "\n",
        "\n",
        "baseline_orders = (\n",
        "    baseline_store.groupby(\"store_id_clean\")[\n",
        "        \"transaction_id\"\n",
        "    ]\n",
        "    .nunique()\n",
        "    .rename(\"baseline_orders\")\n",
        ")\n",
        "\n",
        "surge_orders = (\n",
        "    surge_store.groupby(\"store_id_clean\")[\n",
        "        \"transaction_id\"\n",
        "    ]\n",
        "    .nunique()\n",
        "    .rename(\"surge_orders\")\n",
        ")\n",
        "\n",
        "\n",
        "store_results = pd.concat(\n",
        "    [baseline_orders, surge_orders],\n",
        "    axis=1\n",
        ").fillna(0)\n",
        "\n",
        "\n",
        "store_results[\"baseline_daily\"] = (\n",
        "    store_results[\"baseline_orders\"] / baseline_days\n",
        ")\n",
        "\n",
        "store_results[\"surge_daily\"] = (\n",
        "    store_results[\"surge_orders\"] / surge_days\n",
        ")\n",
        "\n",
        "\n",
        "store_results[\"percent_change\"] = (\n",
        "    (\n",
        "        store_results[\"surge_daily\"]\n",
        "        / store_results[\"baseline_daily\"].replace(\n",
        "            0, np.nan\n",
        "        )\n",
        "    ) - 1\n",
        ") * 100\n",
        "\n",
        "store_results = store_results.sort_values(\n",
        "    \"percent_change\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"\\nQ4 — Store-Level Demand Comparison\")\n",
        "print(\"Number of standardized stores:\", len(store_results))\n",
        "\n",
        "display(store_results.round(2))\n",
        "\n",
        "\n",
        "assert store_results.index.is_unique, (\n",
        "    \"Duplicate store IDs found in results.\"\n",
        ")\n",
        "\n",
        "assert len(store_results) == (\n",
        "    store_df[\"store_id_clean\"].nunique()\n",
        "), \"Store count does not match cleaned data.\"\n",
        "\n",
        "print(\"Validation passed: each store appears once.\")\n",
        "\n",
        "\n",
        "plot_data = (\n",
        "    store_results[\"percent_change\"]\n",
        "    .dropna()\n",
        "    .sort_values()\n",
        ")\n",
        "\n",
        "plt.figure(figsize=(11, 6))\n",
        "\n",
        "bars = plt.barh(\n",
        "    plot_data.index,\n",
        "    plot_data.values,\n",
        "    color=[\n",
        "        \"seagreen\" if x >= 0 else \"salmon\"\n",
        "        for x in plot_data.values\n",
        "    ]\n",
        ")\n",
        "\n",
        "plt.axvline(0, color=\"black\", linewidth=1)\n",
        "\n",
        "plt.title(\n",
        "    \"Change in Average Daily Orders by Standardized Store\"\n",
        ")\n",
        "\n",
        "plt.xlabel(\"Change from Baseline (%)\")\n",
        "plt.ylabel(\"Store ID\")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n",
        "\n",
        "print(\"\\nStores with largest increases:\")\n",
        "display(store_results.head(3).round(2))\n",
        "\n",
        "print(\"\\nStores with smallest increases:\")\n",
        "display(store_results.tail(3).round(2))\n"
      ]
    },
