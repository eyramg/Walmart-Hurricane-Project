,\n      \"properties\": {\n        \"dtype\": \"number\",\n        \"std\": 8.275030714948027,\n        \"min\": 115.43,\n        \"max\": 131.25,\n        \"num_unique_values\": 3,\n        \"samples\": [\n          131.25,\n          127.55,\n          115.43\n        ],\n        \"semantic_type\": \"\",\n        \"description\": \"\"\n      }\n    }\n  ]\n}"
