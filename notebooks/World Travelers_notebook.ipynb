      "source": [
        "import pandas as pd\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "import re\n",
        "\n",
        "sku_df = df.copy()\n",
        "\n",
        "\n",
        "sku_df[\"sku_clean\"] = (\n",
        "    sku_df[\"sku\"]\n",
        "    .astype(\"string\")\n",
        "    .str.strip()\n",
        "    .str.upper()\n",
        ")\n",
        "\n",
        "\n",
        "def canonicalize(name):\n",
        "    if pd.isna(name):\n",
        "        return \"unknown\"\n",
        "\n",
        "    name = str(name).lower().strip()\n",
        "    name = re.sub(r\"[^a-z0-9]+\", \" \", name)\n",
        "    name = re.sub(r\"\\s+\", \" \", name).strip()\n",
        "\n",
        "    if \"strawberry\" in name and (\n",
        "        \"pop tart\" in name or \"poptart\" in name\n",
        "    ):\n",
        "        return \"pop tarts strawberry\"\n",
        "\n",
        "    if \"monopoly\" in name:\n",
        "        return \"monopoly board game\"\n",
        "\n",
        "    if \"water\" in name and \"24\" in name:\n",
        "        return \"bottled water 24 pack\"\n",
        "\n",
        "    if \"aa\" in name and (\n",
        "        \"battery\" in name or \"batteries\" in name\n",
        "    ):\n",
        "        return \"aa batteries 4 pack\"\n",
        "\n",
        "    return name\n",
        "\n",
        "sku_df[\"canonical_name\"] = (\n",
        "    sku_df[\"product_name\"].apply(canonicalize)\n",
        ")\n",
        "\n",
        "\n",
        "sku_name_counts = (\n",
        "    sku_df.groupby(\"sku_clean\")[\"canonical_name\"]\n",
        "    .nunique()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "problem_skus = sku_name_counts[\n",
        "    sku_name_counts > 1\n",
        "]\n",
        "\n",
        "print(\"SKUs with multiple cleaned names:\", len(problem_skus))\n",
        "display(problem_skus)\n",
        "\n",
        "\n",
        "if len(problem_skus) > 0:\n",
        "    display(\n",
        "        sku_df[\n",
        "            sku_df[\"sku_clean\"].isin(problem_skus.index)\n",
        "        ][\n",
        "            [\"sku_clean\", \"product_name\", \"canonical_name\"]\n",
        "        ]\n",
        "        .drop_duplicates()\n",
        "        .sort_values([\"sku_clean\", \"canonical_name\"])\n",
        "    )\n",
        "\n",
        "\n",
        "sku_mapping = (\n",
        "    sku_df.groupby(\"sku_clean\")[\"canonical_name\"]\n",
        "    .agg(lambda values: values.value_counts().index[0])\n",
        "    .to_dict()\n",
        ")\n",
        "\n",
        "\n",
        "poptart_skus = [\n",
        "    \"POPTART-STRAW\",\n",
        "    \"PT-12\",\n",
        "    \"PT_STRAWBERRY\",\n",
        "    \"SKU#459812\"\n",
        "]\n",
        "\n",
        "for sku in poptart_skus:\n",
        "    sku_mapping[sku] = \"pop tarts strawberry\"\n",
        "\n",
        "monopoly_skus = [\n",
        "    \"BG-MONO\",\n",
        "    \"GAME-MONO\",\n",
        "    \"MONOPOLY-01\"\n",
        "]\n",
        "\n",
        "for sku in monopoly_skus:\n",
        "    sku_mapping[sku] = \"monopoly board game\"\n",
        "\n",
        "\n",
        "sku_df[\"canonical_product\"] = (\n",
        "    sku_df[\"sku_clean\"].map(sku_mapping)\n",
        ")\n",
        "\n",
        "\n",
        "mapping_check = (\n",
        "    sku_df.groupby(\"sku_clean\")[\"canonical_product\"]\n",
        "    .nunique()\n",
        ")\n",
        "\n",
        "assert (mapping_check <= 1).all(), (\n",
        "    \"One or more SKUs still map to multiple products.\"\n",
        ")\n",
        "\n",
        "\n",
        "mapping_table = pd.DataFrame(\n",
        "    list(sku_mapping.items()),\n",
        "    columns=[\"original_sku\", \"canonical_product\"]\n",
        ").sort_values(\"original_sku\")\n",
        "\n",
        "print(\"\\nSKU mapping table:\")\n",
        "display(mapping_table)\n",
        "\n",
        "\n",
        "units_before = sku_df[\"quantity\"].sum()\n",
        "\n",
        "consolidated = (\n",
        "    sku_df.groupby(\"canonical_product\", as_index=False)\n",
        "    [\"quantity\"].sum()\n",
        ")\n",
        "\n",
        "units_after = consolidated[\"quantity\"].sum()\n",
        "\n",
        "assert np.isclose(units_before, units_after), (\n",
        "    \"Total units changed during consolidation!\"\n",
        ")\n",
        "\n",
        "print(\"\\nQ2 — SKU Consolidation\")\n",
        "print(\"Original distinct SKUs:\", sku_df[\"sku_clean\"].nunique())\n",
        "print(\n",
        "    \"Canonical products:\",\n",
        "    sku_df[\"canonical_product\"].nunique()\n",
        ")\n",
        "print(\"Units before:\", units_before)\n",
        "print(\"Units after:\", units_after)\n",
        "\n",
        "\n",
        "poptarts = sku_df[\n",
        "    sku_df[\"sku_clean\"].isin(poptart_skus)\n",
        "].copy()\n",
        "\n",
        "poptarts_before = (\n",
        "    poptarts.groupby(\"sku_clean\")[\"quantity\"]\n",
        "    .sum()\n",
        "    .sort_values(ascending=False)\n",
        ")\n",
        "\n",
        "poptarts_after = poptarts[\"quantity\"].sum()\n",
        "\n",
        "print(\"\\nPop-Tarts units by original SKU:\")\n",
        "display(poptarts_before)\n",
        "\n",
        "print(\"Total consolidated Pop-Tarts units:\", poptarts_after)\n",
        "\n",
        "assert np.isclose(\n",
        "    poptarts_before.sum(),\n",
        "    poptarts_after\n",
        ")\n",
        "\n",
        "\n",
        "fig, axes = plt.subplots(1, 2, figsize=(13, 5))\n",
        "\n",
        "bars1 = axes[0].bar(\n",
        "    poptarts_before.index,\n",
        "    poptarts_before.values,\n",
        "    color=\"steelblue\"\n",
        ")\n",
        "\n",
        "axes[0].set_title(\"Before: Pop-Tarts by Original SKU\")\n",
        "axes[0].set_xlabel(\"Original SKU\")\n",
        "axes[0].set_ylabel(\"Units Sold\")\n",
        "axes[0].tick_params(axis=\"x\", rotation=45)\n",
        "axes[0].bar_label(bars1)\n",
        "\n",
        "bars2 = axes[1].bar(\n",
        "    [\"Strawberry Pop-Tarts\"],\n",
        "    [poptarts_after],\n",
        "    color=\"seagreen\"\n",
        ")\n",
        "\n",
        "axes[1].set_title(\"After: Consolidated Pop-Tarts\")\n",
        "axes[1].set_ylabel(\"Units Sold\")\n",
        "axes[1].bar_label(bars2)\n",
        "\n",
        "fig.suptitle(\n",
        "    \"Strawberry Pop-Tarts Sales Before and After SKU Mapping\"\n",
        ")\n",
        "\n",
        "plt.tight_layout()\n",
        "plt.show()\n",
        "\n"
      ]
    },
    {
      "cell_type": "markdown",
      "id": "2782ea72",
      "metadata": {
        "id": "2782ea72"
      },
      "source": [
        "**Q2 answer:** We started with 45 different SKUs and consolidated them into 24 canonical products. During the cleaning process, we found that 30 SKUs were associated with multiple cleaned product names, so we standardized the mappings to make sure each SKU was assigned to one consistent product. For example, Strawberry Pop-Tarts appeared under 4 different SKUs, which we combined into one product with a total of 5,005 units sold. The total number of units stayed the same at 47,897 before and after consolidation, showing that no units were lost during the process."
      ]
    },
